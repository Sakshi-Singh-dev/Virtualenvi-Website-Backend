# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to GitHub — it's already in .gitignore.

PORT=5000

# Get this from MongoDB Atlas: Database > Connect > Drivers
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/virtualenvi
MONGODB_URI=

# Week 3 — Resend email API (get your key from resend.com -> API Keys)
RESEND_API_KEY=your_resend_api_key_here
NOTIFY_EMAIL=your_notification_email_here
